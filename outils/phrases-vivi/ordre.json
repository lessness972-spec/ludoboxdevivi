 {
  "chapitre": "Vivi 4 - Vêtements (histoires)",
  "paragraphes": [
   {
    "texte": "Brrr, il fait froid ! Je m'habille pour aller à l'école. Qu'est-ce que je mets sur mes jambes ?",
    "fichiers": [
     "vet_froid_1"
    ]
   },
   {
    "texte": "Oui ! Le pantalon, pour avoir les jambes au chaud.",
    "fichiers": [
     "vet_froid_1_bravo"
    ]
   },
   {
    "texte": "Qu'est-ce que je mets sur mon corps ?",
    "fichiers": [
     "vet_froid_2",
     "vet_pluie_2"
    ]
   },
   {
    "texte": "Oui ! Le t-shirt va sur mon corps.",
    "fichiers": [
     "vet_froid_2_bravo",
     "vet_pluie_2_bravo"
    ]
   },
   {
    "texte": "Qu'est-ce que je mets sur mes pieds, avant les chaussures ?",
    "fichiers": [
     "vet_froid_3"
    ]
   },
   {
    "texte": "Bravo ! Les chaussettes vont sur les pieds.",
    "fichiers": [
     "vet_froid_3_bravo",
     "vet_pluie_3_bravo"
    ]
   },
   {
    "texte": "Il fait froid dehors. Qu'est-ce que je mets par-dessus pour sortir ?",
    "fichiers": [
     "vet_froid_4"
    ]
   },
   {
    "texte": "Super ! Le manteau me tient bien chaud.",
    "fichiers": [
     "vet_froid_4_bravo"
    ]
   },
   {
    "texte": "Qu'est-ce que je mets autour de mon cou ?",
    "fichiers": [
     "vet_froid_5"
    ]
   },
   {
    "texte": "Oui ! L'écharpe se met autour du cou.",
    "fichiers": [
     "vet_froid_5_bravo"
    ]
   },
   {
    "texte": "Qu'est-ce que je mets sur mes mains ?",
    "fichiers": [
     "vet_froid_6"
    ]
   },
   {
    "texte": "Bravo ! Les gants, pour avoir les mains au chaud.",
    "fichiers": [
     "vet_froid_6_bravo"
    ]
   },
   {
    "texte": "Je suis prêt ! Qu'est-ce que je prends pour aller à l'école ?",
    "fichiers": [
     "vet_froid_7",
     "vet_pluie_7",
     "vet_chaud_6"
    ]
   },
   {
    "texte": "Bravo ! Le cartable, et en route pour l'école !",
    "fichiers": [
     "vet_froid_7_bravo",
     "vet_pluie_7_bravo",
     "vet_chaud_6_bravo"
    ]
   },
   {
    "texte": "Oh, il pleut ! Je m'habille pour aller à l'école. Qu'est-ce que je mets sur mes jambes ?",
    "fichiers": [
     "vet_pluie_1"
    ]
   },
   {
    "texte": "Oui ! Le pantalon va sur les jambes.",
    "fichiers": [
     "vet_pluie_1_bravo"
    ]
   },
   {
    "texte": "Qu'est-ce que je mets sur mes pieds, avant les bottes ?",
    "fichiers": [
     "vet_pluie_3"
    ]
   },
   {
    "texte": "Il pleut ! Qu'est-ce que je mets à mes pieds pour sauter dans les flaques ?",
    "fichiers": [
     "vet_pluie_4"
    ]
   },
   {
    "texte": "Super ! Avec les bottes, mes pieds restent au sec.",
    "fichiers": [
     "vet_pluie_4_bravo"
    ]
   },
   {
    "texte": "Qu'est-ce que je mets par-dessus pour ne pas être mouillé ?",
    "fichiers": [
     "vet_pluie_5"
    ]
   },
   {
    "texte": "Oui ! Le manteau me protège de la pluie.",
    "fichiers": [
     "vet_pluie_5_bravo"
    ]
   },
   {
    "texte": "Qu'est-ce que je prends pour me protéger de la pluie ?",
    "fichiers": [
     "vet_pluie_6"
    ]
   },
   {
    "texte": "Bravo ! Le parapluie, pour ne pas avoir la tête mouillée.",
    "fichiers": [
     "vet_pluie_6_bravo"
    ]
   },
   {
    "texte": "Il fait chaud et il y a du soleil ! Je m'habille pour aller à l'école. Qu'est-ce que je mets sur mon corps ?",
    "fichiers": [
     "vet_chaud_1"
    ]
   },
   {
    "texte": "Oui ! Le t-shirt, c'est léger quand il fait chaud.",
    "fichiers": [
     "vet_chaud_1_bravo"
    ]
   },
   {
    "texte": "Il fait chaud ! Qu'est-ce que je mets sur mes jambes ?",
    "fichiers": [
     "vet_chaud_2"
    ]
   },
   {
    "texte": "Bravo ! Le short va sur les jambes.",
    "fichiers": [
     "vet_chaud_2_bravo"
    ]
   },
   {
    "texte": "Qu'est-ce que je mets sur mes pieds pour courir dans la cour ?",
    "fichiers": [
     "vet_chaud_3"
    ]
   },
   {
    "texte": "Super ! Avec les baskets, je cours très vite.",
    "fichiers": [
     "vet_chaud_3_bravo"
    ]
   },
   {
    "texte": "Le soleil tape fort. Qu'est-ce que je mets sur ma tête ?",
    "fichiers": [
     "vet_chaud_4"
    ]
   },
   {
    "texte": "Oui ! La casquette protège ma tête du soleil.",
    "fichiers": [
     "vet_chaud_4_bravo"
    ]
   },
   {
    "texte": "Le soleil brille. Qu'est-ce que je mets sur mes yeux ?",
    "fichiers": [
     "vet_chaud_5"
    ]
   },
   {
    "texte": "Bravo ! Les lunettes de soleil protègent mes yeux.",
    "fichiers": [
     "vet_chaud_5_bravo"
    ]
   }
  ]
